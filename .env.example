# ==============================================================================
# KaryaGuard - Environment Variables Template
# JANGAN PERNAH MEMASUKKAN KREDENSIAL ATAU PASSWORD NYATA KE FILE INI!
# Copy file ini menjadi .env lalu isi nilainya secara lokal / di dashboard Vercel.
# ==============================================================================

# Database Connection String (Neon PostgreSQL Serverless / Local Postgres)
# Contoh Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Contoh Docker Lokal: postgresql://karyaguard_user:karyaguard_pass@localhost:5432/karyaguard_db?schema=public
DATABASE_URL="postgresql://karyaguard_user:karyaguard_pass@localhost:5432/karyaguard_db?schema=public"

# Enkripsi Token Sesi JWT (Minimal 32 karakter acak)
JWT_SECRET="ganti_dengan_random_secret_string_minimal_32_karakter_karyaguard"

# URL Publik Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Kunci Garam untuk Verifikasi Integritas Slip Gaji SHA-256
PAYROLL_HASH_SALT="ganti_dengan_salt_rahasia_untuk_hash_slip_gaji"

